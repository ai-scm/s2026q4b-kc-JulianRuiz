# ---------- Keycloak (lo lee docker-compose.yml) ----------
KEYCLOAK_VERSION=26.8.2
KEYCLOAK_PORT=8080
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=cambia-esta-clave

# ---------- App Python (lo lee app/app.py) ----------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=semillero
OIDC_CLIENT_ID=hola-mundo-app
OIDC_CLIENT_SECRET=se-copia-de-keycloak-en-la-fase-3
APP_BASE_URL=http://localhost:5000
APP_HOST=127.0.0.1
APP_PORT=5000
APP_SECRET_KEY=se-genera-en-la-fase-1
LOG_LEVEL=INFO

# El Client ID / Secret de GOOGLE no van aquí: se pegan dentro de Keycloak.
